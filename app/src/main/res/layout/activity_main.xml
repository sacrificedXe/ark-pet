<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="初雪桌宠"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="12dp"
            android:text="版本 -" />

        <!-- 自检面板：放最前面，打不开时第一眼就能看到缺什么 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="运行自检"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="8dp"
            android:background="#11000000"
            android:layout_marginTop="4dp"
            android:text="正在检测…" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btn_refresh_diag"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="重新自检" />

            <Button
                android:id="@+id/btn_view_log"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="查看日志" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22000000"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="服务器地址"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_server_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ws://39.104.27.214:9100/ws"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WS 端口 9100，HTTP 更新端口 9101。留空也能用，只是没有远程控制。"
            android:textSize="11sp"
            android:textColor="#888888" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="保存地址" />

            <Button
                android:id="@+id/btn_test_conn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="测试连通" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22000000"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_overlay_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. 授予悬浮窗权限" />

        <Button
            android:id="@+id/btn_acc_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. 开启无障碍服务"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. 启动桌宠"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="停止桌宠"
            android:layout_marginTop="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22000000"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="角色"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/sp_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="皮肤"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/sp_skin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_size_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="大小：100%"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <SeekBar
            android:id="@+id/sb_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="250"
            android:progress="100" />

        <Switch
            android:id="@+id/sw_behavior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自主行为（待机 / 走路）"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btn_check_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="检查更新"
            android:layout_marginTop="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22000000"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <!-- Shizuku 授权。S5（StudyOS）的 PackageInstaller 只认自家 BPK 格式，
             第三方 APK 走系统安装器一律「家教机无法识别」，且机器无 root。
             只剩 Shizuku：以 shell uid 调 pm install，与 adb install 同一条路。
             必须由 App 主动 requestPermission 一次，否则 Shizuku 授权列表里
             压根不会出现本应用，用户无从手动勾选。 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shizuku 授权（静默安装 / MAA 通道）"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_shizuku_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="8dp"
            android:background="#11000000"
            android:layout_marginTop="4dp"
            android:text="未检测" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btn_shizuku_request"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="申请授权" />

            <Button
                android:id="@+id/btn_shizuku_test"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="测试通道" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22000000"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <!-- MAA-Meow 联动。原来只能通过 WS 远程下 maa.start，机上没有任何入口，
             表现就是「MAA 的界面在哪儿」——功能在，门没开。 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAA-Meow 联动"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_maa_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="8dp"
            android:background="#11000000"
            android:layout_marginTop="4dp"
            android:text="未检测" />

        <EditText
            android:id="@+id/et_maa_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="任务配置 UUID（MAA-Meow 后台任务里复制）"
            android:inputType="text"
            android:maxLines="1"
            android:layout_marginTop="6dp" />

        <Switch
            android:id="@+id/sw_maa_force"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="强制启动（忽略游戏已在运行）" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btn_maa_check"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="检测" />

            <Button
                android:id="@+id/btn_maa_start"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="启动任务" />

            <Button
                android:id="@+id/btn_maa_stop"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="停止" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_maa_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开 MAA-Meow 主界面"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MAA-Meow 需自行安装，且要 root 或 Shizuku 授权才能被拉起。Shizuku 通道当前不可用（反射待修），只有 root 机能用。"
            android:textSize="11sp"
            android:textColor="#888888" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="双击桌宠弹出输入框，长按切换皮肤，拖动移动位置。"
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>
